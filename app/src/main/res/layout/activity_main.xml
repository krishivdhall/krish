<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:orientation="vertical" android:padding="18dp"
      android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:text="Krish RGB Controller • TEST BUILD" android:textSize="22sp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/status" android:text="Disconnected" android:paddingTop="8dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <Button android:id="@+id/connect" android:text="Connect to GATT-DEMO"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/red" android:text="Test Red"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/yellow" android:text="Test Yellow"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/white" android:text="Test White"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/effect1" android:text="Effect 01"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/effect4c" android:text="Effect 4C"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="Speed" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <SeekBar android:id="@+id/speed" android:max="100" android:progress="100"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/rawHex" android:hint="Raw HEX e.g. BC 06 02 00 01 55"
        android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/sendRaw" android:text="Send Raw HEX"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="Note: color packets are test candidates from the captured session. Use the raw sender to identify exact commands."
        android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  </LinearLayout>
</ScrollView>
